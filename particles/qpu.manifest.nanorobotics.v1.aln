aln
aln SHARD qpu.manifest.nanorobotics.v1
PATH particles/qpu.manifest.nanorobotics.v1.aln
VER 1.0.0
LIC MIT-OR-Apache-2.0
DESC QPU manifest for nanorobotics kernels, guards, and ALN shards.
DESC Provides an append-only catalog of kernel IDs, crate versions, and proof anchors.

shard qpu.manifest.nanorobotics.v1
version 1.0.0
created 2026-06-28T00:00:00Z
author DataLake Sovereign Nanorobotics
license MIT-OR-Apache-2.0

binding
  hostdid did.aln.bostrom-organic-host
  primarybostromaddress bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7
  alnmigrationclause ALN.MIGRATION.CYBERCOREAUTHORITY.v1
end

SECTION SCHEMA
section schema

record KernelManifestEntryV1
  entryid string
  createdAt string
  crateName string
  crateVersion string
  shardId string
  shardPath string
  kaniProofId string
  rohCeiling f32
  ecoDeltaMax f32
  neurorightsProfileId string
end

invariant rohceilingleqglobal KernelManifestEntryV1.rohCeiling ≤ 0.30
invariant ecodeltanonpositive KernelManifestEntryV1.ecoDeltaMax ≤ 0.0

end

SECTION STORAGE
section storage

logseries NanoroboticsKernelManifest
  description Append-only manifest of all nanorobotics guard/kernels.

  entryschema KernelManifestEntryV1

  invariants
    - name appendonly
      description Entries may only be appended; no edits or deletions.
      enforcement organichain.appendonly
    end
  end

  indexing
    - by entryid
    - by crateName
    - by shardId
  end
end

end

SECTION VERSION HISTORY
section versionhistory
  version 1.0.0
  releasedate 2026-06-28
  changes
    - Initial QPU manifest shard for nanorobotics kernels and guards.
  end
end

endshard qpu.manifest.nanorobotics.v1
