record CerebralArterialCorridorV1
  corridor.id,string          -- "cerebral-arterial-main"
  organ.id,string             -- "brain"
  vascular.tree.id,string     -- "cerebral-arterial-tree-v1"
  segment.type,string         -- "arteriole-capillary-venule"

  -- Hemodynamic corridor (per Weber/Ju + HRA cerebral artery data).[file:27][file:25]
  wss.setpoint.pa,float       -- nominal mean WSS (e.g., 12.0 Pa)
  wss.lower.pa,float          -- lower safe bound (e.g., 8.0 Pa)
  wss.upper.pa,float          -- upper safe bound (e.g., 18.0 Pa)
  osi.max,float               -- max oscillatory shear index (e.g., 0.3)

  -- Density corridor (capillary + microvascular field).[file:27]
  hct.systemic.range,float    -- "0.35,0.45"
  hct.tube.min,float          -- 0.30
  hct.tube.max,float          -- 0.50

  phi.tot.maxsafe,float       -- max total particulate volume fraction φ_tot,max
  rho.ceiling.per.m3,float    -- max swarm number density per m^3
  densityrisk.max.exceed.frac,float -- f_exceed ceiling (fraction of nodes above rho_ceiling)

  clog.score.softthreshold,float   -- e.g., 2.5
  clog.score.hardthreshold,float   -- e.g., 5.0

  -- Numerical FP corridor (for cerebral capillary FP solver).[file:27][file:25]
  fp.dx.m,float              -- spatial step along capillary
  fp.dt.s,float              -- time step
  fp.diffusion.m2.per.s,float -- D
  fp.max.horizon.s,float     -- max simulation time horizon

  -- RoH weighting and local slice.[file:27]
  roh.weight.biomech,float   -- weight for WSS/OSI violations
  roh.weight.density,float   -- weight for density/clogging risk
  roh.slice.max,float        -- max local RoH for this corridor (≤ 0.30)
end record

record CerebralArterialEvidenceBundle10
  bundle.id,string          -- "cerebral-arterial-evidence-2026-01"
  corridor.id,string        -- link to CerebralArterialCorridorV1.corridor.id
  tags,string               -- 10 hex tags, e.g. "0xa1f3c9b2,..."
  references,string         -- comma-separated PMIDs/DOIs/HRA IDs
  data.quality,string       -- "A", "B", etc.
  synthetic.flag,bool       -- true if parameters are synthetic-conservative
end record
