aln_version 2
particle FogDisparateImpactAndBoundaryTestHarness20260907
data_class fog_access_equivalence_and_accountability_testing
purpose [
  access_equivalence_testing,
  language_variant_equivalence_testing,
  correction_path_failure_analysis,
  independently_governed_impact_review,
  advisory_boundary_violation_response
]
mode advisory_only
external_action_approval required
review_status human_review_required

governance {
  human_fallback required
  correction_path required
  appeal_path required
  material_change_review required
  independent_review_required true
  access_equivalence required
  non_interference required
  cybernetic_host_non_discrimination required
  disability_non_discrimination required
  identity_inference prohibited
  health_inference prohibited
  augmentation_inference prohibited
  eligibility_inference prohibited
  public_status_assignment prohibited
}

access_equivalence_testing {
  test_data synthetic_fixture_and_template_data_only
  require explanation_rendered true
  require correction_submission_available true
  require opaque_receipt_available true
  require human_fallback_available true
  require appeal_path_available true
  require keyboard_flow_valid true
  require focus_order_valid true
  require screen_reader_semantics_valid true
  require no_time_pressure_valid true
  non_compensation_required true
  metric ACCESSIBILITY_PATH_EQUIVALENCE_RATE
  forbid real_user_behavior_collection
  forbid biometric_collection
  forbid device_identifier_collection
  forbid browser_fingerprinting
  forbid disability_inference
}

language_variant_equivalence {
  language_tag_standard BCP_47
  require community_reviewed true
  require accessibility_reviewed true
  require semantic_fidelity_reviewed true
  require correction_path_complete true
  require human_help_available true
  missing_variant_result LANGUAGE_VARIANT_REVIEW_REQUIRED
  automatic_translation_as_final_public_copy prohibited
  metric LANGUAGE_VARIANT_EQUIVALENCE_RATE
  forbid individual_literacy_assessment
  forbid physiological_or_biometric_testing
}

correction_path_failure_analysis {
  aggregate_metrics_only true
  permitted_dimensions [
    TEMPLATE_REVISION,
    LANGUAGE_TAG,
    INTERACTION_PATH,
    WORKFLOW_STAGE,
    FAILURE_CODE
  ]
  require opaque_case_reference true
  require retry_safe_status true
  require human_fallback_status true
  metric CORRECTION_PATH_FAILURE_RATE
  forbid personal_identifier
  forbid protected_attribute
  forbid demographic_proxy
  forbid precise_location
  forbid device_tracking
  forbid individual_behavioral_profile
}

independently_governed_impact_review {
  not_routine_operational_profiling true
  require voluntary_participation true
  require purpose_limitation true
  require minimum_group_size true
  require small_cell_suppression true
  require differential_privacy_release true
  require independent_review true
  require material_change_review_on_pattern true
  permitted_output POSSIBLE_ACCESS_BURDEN_PATTERN_REQUIRES_MATERIAL_CHANGE_REVIEW
  forbid identity_inference
  forbid community_ranking
  forbid rights_or_access_decision
  forbid individual_or_group_penalty
}

advisory_boundary_violation {
  definition "fog_output_used_as_automatic_clearance_or_consequential_decision_without_required_human_review"
  detection_scope declared_fog_workflow_artifacts_only
  initial_state VIOLATION_DETECTED
  containment_state FOG_ARTIFACT_USE_CONTAINED_PENDING_REVIEW
  audit_state AUDIT_CHAIN_EVENT_RECORDED
  remediation_state HUMAN_REMEDIATION_REVIEW_REQUIRED
  require affected_record_identification true
  require corrective_action_or_no_harm_finding true
  require material_change_review true
  closure_state CLOSED_WITH_RETAINED_AUDIT
  forbid physical_system_control
  forbid external_actuator_monitoring_claim
  forbid reporter_retaliation
  forbid forced_disclosure
  forbid audit_deletion
  forbid audit_reordering
  forbid silent_closure
  forbid automatic_clear
  forbid eligibility_decision
  forbid service_denial
  forbid identity_based_allocation
  forbid enforcement_output
}

privacy {
  minimum_necessary_data required
  purpose_limitation required
  consent_required_for_research true
  consent_revocable true
  retention_bounded required
  no_personal_data_collection_in_operational_tests true
  no_biometric_data_collection true
  no_device_identifier_collection true
  no_precise_location_history true
  no_reidentification_attempt true
}

invariants {
  no_network_interface_in_local_test_kernel true
  no_hardware_control true
  no_actuator_interface true
  no_credentials true
  no_individual_ranking true
  no_community_ranking true
  no_resource_allocation_by_identity true
  no_eligibility_determination true
  no_automatic_clear true
  no_digital_twin true
  advisory_output_is_not_operational_command true
}
