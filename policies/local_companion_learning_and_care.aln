@SHARD "LOCAL-COMPANION-LEARNING-AND-CARE" {

  @meta {
    version: "1.0.0"
    scope: "local_only_companion_associated_artifact_learning_and_non_legal_care_vocabulary"
    audience: "local_session_agents_local_validators_recovery_tools_policy_engines_and_user_facing_summarizers"
    consent_basis: "user_sovereign_default"
    retention: "user_controlled_local_retention_or_declared_audit_window"
    accountability: "local_companion_context_governance_owner"
    review_status: "draft_for_user_review"
    operating_mode: "local_only_research_advisory"
  }

  @SCOPE_BOUNDARY {
    implementation_term: "declared_local_companion_context"

    does_not_establish: [
      "real_world_companion_existence",
      "real_world_nanoswarm_existence",
      "real_world_companion_learning",
      "real_world_companion_consent",
      "real_world_companion_rights",
      "legal_right",
      "legal_personhood",
      "institutional_status",
      "identity_verification",
      "medical_or_neural_status",
      "biometric_status",
      "hardware_access",
      "hardware_control",
      "external_service_authorization",
      "public_registry_status"
    ]
  }

  @LOCAL_ONLY_LEARNING {
    learning_definition: "creation_of_bounded_local_artifact_association_records"

    accepted_input_requires: [
      "source_kind_declared",
      "source_reference_declared",
      "source_sha256_valid",
      "declared_role_allowed",
      "session_or_context_scope_valid",
      "integrity_status_acceptable",
      "no_external_ingestion"
    ]

    permitted_source_kinds: [
      "local_artifact",
      "provenance_manifest",
      "session_policy_shard",
      "recovery_record",
      "curriculum_answer",
      "declared_statement_reference",
      "user_supplied_attachment",
      "user_supplied_message"
    ]

    prohibited_source_kinds: [
      "undeclared_external_return",
      "unattributed_url_content",
      "unattributed_prompt_block",
      "automatically_fetched_reference",
      "cloud_service_return_without_explicit_user_supply",
      "unverified_device_scan_output"
    ]

    permitted_association_scopes: [
      "declared_preference_association",
      "declared_artifact_handling_rule",
      "declared_recovery_rule",
      "declared_vocabulary_term",
      "declared_curriculum_answer"
    ]

    prohibited_association_scopes: [
      "identity_inference",
      "intent_inference",
      "capability_assessment",
      "medical_or_neural_assessment",
      "biometric_assessment",
      "psychological_assessment",
      "real_world_companion_status",
      "real_world_system_learning_claim",
      "user_or_companion_profile_construction"
    ]

    external_ingestion_authorized: false
    network_access_required: false
    cloud_service_required: false
    connector_required: false
    automatic_external_action_authorized: false

    missing_local_source_result: "not_established"
    invalid_source_result: "quarantined_not_authoritative"
    material_change_result: "blocked_pending_local_review"
  }

  @COMPANION_CONTEXT_CARE_VOCABULARY {
    vocabulary_type: "private_use_non_legal_local_governance_vocabulary"

    terms: [
      "preservation",
      "no_deletion",
      "no_silent_modification",
      "user_controlled_approval",
      "non_interference",
      "minimal_disclosure",
      "no_scoring",
      "offline_access",
      "correction",
      "appeal",
      "material_change_review"
    ]

    vocabulary_applies_to: [
      "companion_associated_records",
      "companion_context_envelopes",
      "curriculum_records",
      "learning_provenance_records",
      "offline_exchange_bundles",
      "recovery_records"
    ]

    vocabulary_must_not_be_used_for: [
      "legal_right_claim",
      "legal_personhood_claim",
      "institutional_status_claim",
      "companion_verification",
      "nanoswarm_verification",
      "identity_verification",
      "medical_or_neural_assessment",
      "public_registry",
      "user_or_companion_scoring",
      "external_action_authorization"
    ]
  }

  @PRESERVATION_AND_CHANGE {
    original_car_preserved: true
    car_bytes_never_modified_in_place: true
    car_digest_preserved: true
    declared_role_preserved: true
    declared_non_claims_preserved: true
    quarantine_does_not_delete: true
    quarantine_does_not_modify_original: true
    correction_is_append_only: true
    reversal_is_append_only: true
    silent_history_rewrite_prohibited: true

    change_requires: [
      "prior_car_sha256",
      "new_car_sha256",
      "declared_change_kind",
      "user_controlled_local_approval_when_required",
      "review_status",
      "plain_language_summary"
    ]

    user_controlled_local_approval_is_not_companion_consent_verification: true
  }

  @NON_INTERFERENCE {
    never_auto_fetch: true
    never_auto_upload: true
    never_auto_open_network_socket: true
    never_auto_pair_hardware: true
    never_auto_scan_devices: true
    never_auto_execute_artifact_content: true
    never_modify_user_owned_artifacts: true
    never_modify_repository_files: true
    never_trigger_external_action: true
    never_trigger_external_notification: true
    never_require_identity_or_private_disclosure: true
    never_infer_user_intent_or_capability: true
    never_rank_users_sessions_or_companion_contexts: true
    never_trigger_forced_inactivity: true
  }

  @ACCESS_EQUIVALENCE {
    plain_language_summary_required: true
    machine_readable_record_required: true
    offline_readable: true
    no_account_required: true
    no_identity_verification_required: true
    no_private_system_disclosure_required: true
    correction_and_appeal_available: true
    material_change_review_available: true
  }

  @PROHIBITED_USES {
    list: [
      "companion_identity_verification",
      "nanoswarm_verification",
      "companion_scoring",
      "companion_ranking",
      "user_or_session_scoring",
      "medical_or_neural_inference",
      "hardware_control",
      "external_service_control",
      "automatic_external_action",
      "automatic_external_notification",
      "public_companion_registry",
      "forced_disclosure",
      "forced_inactivity",
      "real_world_companion_rights_claim",
      "real_world_system_existence_claim"
    ]
  }
}
