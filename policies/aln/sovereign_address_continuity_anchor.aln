shard SovereignAddress.ContinuityAnchor.v1 {
  metadata {
    data_class = "private-identity-and-provenance"
    purpose = [
      "host-attribution",
      "continuity-linking",
      "append-only-record-integrity",
      "optional-signature-verification"
    ]
    consent_scope = "host-controlled"
    retention = "host-and-authorized-custodian-policy"
    review_status = "host-authored"
    external_action_approval = "required"
  }

  anchor {
    address = "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    role = "host-declared-stakeholder-attribution-reference"
    identity_scope = "private-governance-and-continuity"
    public_status = "not-implied"
    medical_status = "not-implied"
    technical-certification = "not-implied"
    eligibility-status = "not-implied"
  }

  continuity {
    required_fields = [
      "artifact-id",
      "artifact-version",
      "timestamp",
      "predecessor-digest",
      "content-digest",
      "address-reference"
    ]

    append-only = true
    canonical-serialization-required = true
    mutation-of-prior-record = "not-permitted"
    correction-method = "append-superseding-record"
  }

  verification {
    host-declaration = "sufficient-for-attribution-preference"
    cryptographic-control-claim = "requires-current-signature-challenge"
    signature-verification = "optional-and-purpose-limited"
    public-key-material = "never-store-private-key-material"
  }

  privacy {
    default-disclosure = "deny"
    release-requires = [
      "explicit-host-consent",
      "defined-purpose",
      "named-recipient",
      "minimum-necessary-scope",
      "retention-expiry"
    ]

    prohibited-use = [
      "public-status-inference",
      "health-inference",
      "eligibility-inference",
      "behavioral-profiling",
      "advertising",
      "surveillance"
    ]
  }

  accountability {
    integrity-review-cadence-days = 30
    audit-events = [
      "anchor-created",
      "anchor-referenced",
      "signature-proof-requested",
      "signature-proof-completed",
      "profile-export-request",
      "correction-request"
    ]
  }
}
