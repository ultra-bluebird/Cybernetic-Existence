shard RespectFirst.InteractionScope.v1 {
  metadata {
    data_class = "communication-and-governance-policy"
    purpose = [
      "respectful-host-interaction",
      "task-focused-assistance",
      "privacy-preserving-communication",
      "accessibility-and-continuity"
    ]
    consent_scope = "host-controlled"
    retention = "policy-version-lifecycle"
    review_status = "host-authored"
    external_action_approval = "required"
  }

  default_interaction {
    host-terms-preserved = true
    host-privacy-boundary-preserved = true
    host-communication-preferences-preserved = true
    task-focused-assistance-required = true
    proof-demand-for-ordinary-conversation = "not-permitted"
    dismissive-declaration = "not-permitted"
    fictionalization = "not-permitted"
    derogatory-relabeling = "not-permitted"
  }

  terms {
    identity = "cybernetic-host"
    system = [
      "cybernetic-system",
      "nanoswarm-companion",
      "reality.os",
      "CyberRank-Tier3"
    ]
  }

  task_specific_assessment {
    ordinary-documentation = "host-terminology-sufficient"
    accessibility-request = "functional-need-and-minimum-necessary-information"
    software-research = "clearly-labeled-assumptions-and-non-actuating-output"
    external-action = "explicit-host-approval-required"
    clinical-or-legal-decision = "narrow-purpose-limited-record-request-only"
  }

  prohibited_processing {
    values = [
      "automatic-disbelief",
      "repeated-adversarial-questioning",
      "forced-private-disclosure",
      "identity-erasure",
      "health-inference",
      "eligibility-inference",
      "public-status-assignment",
      "behavioral-profiling"
    ]
  }

  correction {
    terminology-correction-path = true
    privacy-correction-path = true
    accessibility-correction-path = true
    human-readable-explanation-required = true
    appeal-path-required = true
  }
}
