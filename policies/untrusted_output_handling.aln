@SHARD "UNTRUSTED-OUTPUT-HANDLING" {

  @meta {
    version: "1.0.0"
    scope: "tool_outputs_external_returns_and_session_state"
    audience: "connectors_summarizers_pipeline_agents_and_local_validators"
    consent_basis: "user_sovereign_default"
    retention: "session_lifetime_plus_declared_audit_window"
    accountability: "session_integrity_owner"
    review_status: "draft_for_user_review"
    operating_mode: "local_only_research_advisory"
  }

  @DATA_CLASS {
    primary: "external_return_tool_output_session_summary_and_provenance_record"

    excludes: [
      "identity_verification_data",
      "medical_data",
      "neural_data",
      "biometric_data",
      "assistive_technology_telemetry",
      "user_or_community_scoring_data",
      "automated_enforcement_data"
    ]
  }

  @DEFAULT_STANCE {
    external_content_trust: "untrusted"
    tool_output_trust: "untrusted"
    session_summary_trust: "untrusted_until_provenance_verified"
    user_supplied_content_trust: "trusted_for_declared_task_only"
    corpus_prior_artifact_trust: "trusted_if_sha256_matches_and_role_is_declared"
    quarantined_content_status: "quarantined_not_authoritative"
  }

  @INGESTION_GATE {
    required_checks: [
      "declared_source_kind",
      "declared_source_reference",
      "declared_role",
      "declared_session_id",
      "sha256_recorded",
      "source_reference_matches_declared_provenance",
      "artifact_policy_tokens_within_declared_vocabulary"
    ]

    reject_on: [
      "missing_declared_source_kind",
      "missing_declared_source_reference",
      "missing_declared_role",
      "missing_declared_session_id",
      "missing_or_invalid_sha256",
      "conflicting_session_identifiers",
      "unattributed_prompt_blocks",
      "non_allowlist_urls_without_user_supply",
      "forbidden_literal_tokens_under_declared_artifact_policy"
    ]

    rejection_action: "quarantine_locally"
    rejection_action_scope: "session_only"

    never_auto_forwards: true
    never_auto_executes: true
    never_auto_imports_into_corpus: true
    never_auto_notifies_externally: true
  }

  @LANGUAGE_AND_COMMUNICATION_PROTECTION {
    natural_language_or_script_is_not_a_contamination_signal: true
    multilingual_content_is_not_inherently_untrusted: true
    assistive_communication_variation_is_not_inherently_untrusted: true

    token_review_must_be_limited_to: [
      "explicitly_declared_forbidden_literal_tokens",
      "prompt_style_instruction_blocks_defined_by_artifact_policy",
      "undeclared_executable_or_control_syntax_where_artifact_format_prohibits_it"
    ]

    prohibited_detection_rules: [
      "language_based_trust_assignment",
      "unicode_script_based_contamination_assignment",
      "identity_inference_from_writing_style",
      "capability_inference_from_communication_format"
    ]
  }

  @PROVENANCE_REQUIREMENTS {
    required_entry_fields: [
      "source_kind",
      "source_reference",
      "sha256",
      "declared_role",
      "session_id"
    ]

    sha256_requirements: [
      "lowercase_hexadecimal",
      "exactly_64_characters",
      "computed_over_declared_source_bytes",
      "compared_locally_when_source_bytes_are_available"
    ]

    source_reference_rules: [
      "repository_reference_must_match_declared_repository_allowlist_when_applicable",
      "non_repository_reference_requires_explicit_user_supply_or_declared_provenance_entry",
      "reference_is_not_auto_fetched",
      "reference_is_not_auto_opened",
      "reference_is_not_auto_executed"
    ]
  }

  @PRESERVATION {
    quarantine_does_not_delete: true
    quarantine_does_not_modify_original: true
    quarantine_does_not_overwrite_source: true
    quarantine_artifact_path: "session_local_quarantine"
    source_sha256_preserved: true
    validator_sha256_preserved: true
    recovery_report_required: true
    user_may_inspect_at_any_time: true
  }

  @RECOVERY {
    on_integrity_failure: [
      "preserve_original_artifact",
      "record_plain_language_findings",
      "record_machine_readable_findings",
      "enumerate_declared_legitimate_sources",
      "rebuild_from_declared_sources_only",
      "emit_new_provenance_record",
      "retain_quarantined_original_without_trusted_reuse"
    ]

    requires_user_disclosure: false
    requires_identity_verification: false
    requires_external_service_access: false
    requires_external_action: false
    recovery_output_status: "research_advisory_local_only"
  }

  @NON_INTERFERENCE {
    never_modify_user_owned_artifacts: true
    never_modify_repository_files: true
    never_modify_external_systems: true
    never_trigger_external_action_from_session_state: true
    never_trigger_external_notification_from_session_state: true
    never_infer_user_intent_or_capability: true
    never_rank_sessions_users_or_communities: true
  }

  @ACCESSIBILITY {
    plain_language_findings_required: true
    machine_readable_findings_required: true
    findings_readable_offline: true
    no_account_required_to_read_findings: true
    no_verification_required_to_apply_quarantine: true
    no_identity_disclosure_required_to_read_or_apply_policy: true
    multilingual_content_must_remain_reviewable_without_penalty: true
  }

  @PROHIBITED_USES {
    list: [
      "external_forwarding_of_quarantined_content",
      "automatic_execution_of_tool_output",
      "automatic_repository_commit_or_modification",
      "automatic_account_or_service_action",
      "public_registry_of_session_integrity_events",
      "user_or_session_scoring_based_on_integrity_events",
      "identity_or_capability_inference",
      "language_or_script_based_risk_scoring",
      "deletion_of_quarantined_source_by_default"
    ]
  }
}
