policy_name = "ess_prioritization_only"
policy_version = "1.0"
record_class = "evidence_support_score"
purpose = "Allow a bounded evidence-support score only for transparent prioritization after mandatory evidence and non-actuation gates pass."
consent_scope = "local_validation_and_non_actuating_research_only"
retention = "bounded_by_repository_retention_policy"
deletion = "remove_derived_score_records_when_no_longer_required"
accountability = "method_review_evidence_review_and_governance_review"
review_status = "required_when_score_components_or_weights_change"
access_equivalence_safeguard = "score_is_not_an_access_eligibility_identity_or_rights_determination"
external_action_approval = "prohibited"

require external_action_authorized == false

require ess_state in [
    "COMPUTED",
    "NOT_COMPUTED_MISSING_COMPONENT",
    "BOUNDED_INTERVAL_ONLY",
    "STALE_UNVERIFIED",
    "METHOD_REVIEW_REQUIRED"
]

require score_scope in [
    "REVIEW_QUEUE_PRIORITIZATION",
    "REPLICATION_GAP_PRIORITIZATION",
    "METHOD_IMPROVEMENT_PRIORITIZATION",
    "MONITORING_DESIGN_COMPARISON",
    "RESEARCH_BACKLOG_TRIAGE"
]

require w1 >= 0
require w2 >= 0
require w3 >= 0
require w4 >= 0
require w1 + w2 + w3 + w4 == 1

when ess_state == "COMPUTED":
    require component_s is_not_null
    require component_r is_not_null
    require component_u is_not_null
    require component_i is_not_null
    require component_s >= 0 and component_s <= 1
    require component_r >= 0 and component_r <= 1
    require component_u >= 0 and component_u <= 1
    require component_i >= 0 and component_i <= 1
    require ess_value >= 0 and ess_value <= 1
    require component_definitions_digest is_not_null
    require weight_rationale_digest is_not_null

when mandatory_promotion_gates_passed != true:
    require promotion_allowed == false
    require ess_may_rank == false

when ess_state in [
    "NOT_COMPUTED_MISSING_COMPONENT",
    "BOUNDED_INTERVAL_ONLY",
    "STALE_UNVERIFIED",
    "METHOD_REVIEW_REQUIRED"
]:
    require ess_may_rank == false

deny when score_scope in [
    "ACCESS_CONTROL",
    "IDENTITY_CLASSIFICATION",
    "RIGHTS_ELIGIBILITY",
    "EXTERNAL_ACTION_AUTHORIZATION"
]

deny when external_action_authorized == true
