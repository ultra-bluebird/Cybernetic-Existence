policy_name = "censored_result_integrity"
policy_version = "1.0"
record_class = "analytical_result"
purpose = "Preserve censored analytical results without converting non-detection into zero."
consent_scope = "local_validation_only"
retention = "bounded_by_repository_retention_policy"
deletion = "remove_derived_test_records_when_no_longer_required"
accountability = "validation_report_with_provenance_digest"
review_status = "required_when_result_state_is_inconclusive_or_contradictory"
access_equivalence_safeguard = "plain_language_status_and_interval_fields"
external_action_approval = "prohibited"

require censoring_status in [
    "NONE",
    "LEFT_CENSORED",
    "RIGHT_CENSORED",
    "INTERVAL_CENSORED",
    "NOT_ANALYZED"
]

when censoring_status == "LEFT_CENSORED":
    require reporting_limit is_not_null
    require result_value is_null_or_equals reporting_limit
    require censor_lower_bound is_null
    require censor_upper_bound equals reporting_limit
    require result_state == "NOT_DETECTED"

when censoring_status == "RIGHT_CENSORED":
    require reporting_limit is_not_null
    require result_value is_null_or_equals reporting_limit
    require censor_lower_bound equals reporting_limit
    require censor_upper_bound is_null

when censoring_status == "INTERVAL_CENSORED":
    require reporting_limit is_not_null
    require result_value is_null_or_equals reporting_limit
    require censor_lower_bound is_not_null
    require censor_upper_bound is_not_null
    require censor_upper_bound >= censor_lower_bound

when censoring_status == "NONE":
    require result_value is_not_null
    require censor_lower_bound is_null
    require censor_upper_bound is_null

deny when result_state == "NOT_DETECTED" and censoring_status == "NONE"
deny when result_state == "MEASURED" and censoring_status != "NONE"
deny when result_state == "NOT_DETECTED" and result_value == 0
