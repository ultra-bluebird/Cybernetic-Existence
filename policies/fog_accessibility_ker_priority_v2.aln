policy fog_accessibility_ker_priority_v2 {
  version = "2"
  classification = "governance_policy"
  advisory_only = true
  non_actuating = true

  accessibility_audit {
    require template_version
    require plain_language_status
    require readable_text_evaluation
    require keyboard_navigation_evaluation
    require screen_reader_semantics_evaluation
    require non_visual_status_equivalence
    require offline_text_availability
    require human_review_path
    require community_review_for_translated_template
    forbid visual_only_status
    forbid forced_time_limit
    forbid personal_data_collection
    forbid assistive_device_tracking
    forbid individual_literacy_inference
    forbid composite_score_compensation_for_essential_failure
  }

  ker_review_priority {
    require explicit_low_knowledge_weight
    require explicit_ecological_value_weight
    require explicit_risk_weight
    require weights_sum_to_one
    require fog_uncertainty
    require human_review_required_state
    require deterministic_tie_break
    require policy_review_status
    forbid automatic_clear
    forbid individual_ranking
    forbid community_ranking
    forbid demographic_inference
    forbid resource_allocation
    forbid service_eligibility_decision
  }

  non_compensation {
    require fog_withhold_preserved_until_human_review
    forbid favorable_ker_score_as_clearance
    forbid priority_score_as_rights_override
    forbid ecological_value_as_privacy_override
  }

  accountability {
    require audit_result
    require priority_policy_version
    require calculation_provenance
    require material_change_review
    require correction_path
    require human_fallback
  }
}
