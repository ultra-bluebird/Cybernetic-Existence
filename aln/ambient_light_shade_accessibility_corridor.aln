shard ALN.AMBIENT_LIGHT_SHADE_ACCESSIBILITY_CORRIDOR.v1 {
  META {
    artifact_id = "ambient-light-shade-accessibility-corridor"
    revision = "1.0.0"
    classification = "host-private-environmental-planning"
    host_did = "OrganicCPU"
    bostrom_address = "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    authority = "ALN.MIGRATION.CYBERCORE_AUTHORITY.v1"
    license = "MIT OR Apache-2.0"
  }

  PURPOSE {
    allowed = [
      "shade-optimized-accessibility-routing",
      "ordinary-sun-and-heat-risk-reduction",
      "local-route-comfort-documentation",
      "environmental-data-quality-review"
    ]

    excluded = [
      "biological-control",
      "medical-diagnosis",
      "autonomous-actuation",
      "individual-trajectory-publication",
      "internal-system-state-inference"
    ]
  }

  STATE {
    segment_inputs = [
      "visible-light-category",
      "solar-irradiance-estimate",
      "uv-index-estimate",
      "shade-coverage",
      "ordinary-protection-score",
      "heat-load-estimate",
      "accessibility-penalty",
      "distance-meters",
      "data-quality"
    ]

    host_feedback = [
      "route-comfort-score",
      "route-usability-score",
      "host-override"
    ]
  }

  COST {
    path_cost =
      "sum(light-weight*light*duration*(1-shade) + uv-weight*uv*duration*(1-protection) + heat-weight*heat*duration + accessibility-weight*accessibility + distance-weight*distance + uncertainty-weight*(1-data-quality))"

    required_bounds = [
      "shade-coverage-in-0-1",
      "ordinary-protection-score-in-0-1",
      "heat-load-estimate-in-0-1",
      "accessibility-penalty-in-0-1",
      "data-quality-in-0-1",
      "duration-nonnegative",
      "distance-nonnegative"
    ]
  }

  CORRIDOR {
    preferred = "high-shade-low-heat-accessible-high-confidence"
    acceptable = "moderate-exposure-and-accessible"
    elevated = "direct-exposure-high-heat-or-low-confidence"
    avoid_when_feasible = "severe-exposure-inaccessible-or-insufficient-data"

    routing_constraints = [
      "accessibility-required",
      "host-override-always-permitted",
      "route-risk-must-not-be-underestimated",
      "uncertainty-increases-cost",
      "no-public-raw-trajectory"
    ]
  }

  PRIVACY {
    route_processing = "host-local-by-default"
    public_contribution = "aggregated-environmental-data-only"
    direct_identifier_storage = false
    private_health_data_storage = false
    raw_trajectory_retention = "host-controlled-minimum"
  }

  GOVERNANCE {
    calibration_review = "seasonal-and-after-material-environment-change"
    route_data_revision_required = true
    host_consent_required_for_external-sharing = true
    platform_decision_mode = "advisory-only"
  }
}
