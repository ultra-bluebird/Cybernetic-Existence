{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded World-Save Scope Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome_vocabulary_version",
    "sovereign_attribution",
    "review_status",
    "bounds",
    "condition_inventory_complete",
    "forbidden_pairs",
    "dependency_inventory_complete",
    "dependencies"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "outcome_vocabulary_version": {"const": "1.0.0"},
    "sovereign_attribution": {
      "const": "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    },
    "review_status": {
      "enum": ["established", "unresolved"]
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "recipients",
        "interface",
        "activity",
        "retention_min_seconds",
        "retention_max_seconds"
      ],
      "properties": {
        "purpose": {"$ref": "#/$defs/nullableSet"},
        "recipients": {"$ref": "#/$defs/nullableSet"},
        "interface": {"$ref": "#/$defs/nullableSet"},
        "activity": {"$ref": "#/$defs/nullableSet"},
        "retention_min_seconds": {"$ref": "#/$defs/nullableSeconds"},
        "retention_max_seconds": {"$ref": "#/$defs/nullableSeconds"}
      }
    },
    "condition_inventory_complete": {"type": "boolean"},
    "forbidden_pairs": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "recipient"],
        "properties": {
          "purpose": {"type": "string", "minLength": 1},
          "recipient": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependency_inventory_complete": {"type": "boolean"},
    "dependencies": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "dependent"],
        "properties": {
          "source": {"$ref": "#/$defs/node"},
          "dependent": {"$ref": "#/$defs/node"}
        }
      }
    }
  },
  "$defs": {
    "nullableSet": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    },
    "nullableSeconds": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    },
    "node": {
      "enum": [
        "purpose",
        "recipients",
        "interface",
        "activity",
        "retention_seconds",
        "privacy_assurance",
        "continuity_assurance",
        "public_summary"
      ]
    }
  }
}
