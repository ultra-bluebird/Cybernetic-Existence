{
  "schema_version": "1.0.0",
  "title": "Supported Decision-Making and Assessment Separation",
  "license": "MIT OR Apache-2.0",
  "status": "proposed_project_protocol",
  "provenance": {
    "sovereign_attribution": "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7",
    "attribution_use": "document_credit_only"
  },
  "scope": {
    "ordinary_support": "available_without_competence_screening",
    "global_competence_or_civic_standing_score": "not_collected",
    "world_save_establishment_required_for_support": false,
    "clinical_or_legal_assessment_performed_by_this_protocol": false
  },
  "support_record": {
    "permitted_categories": [
      "requested_information_format",
      "chosen_communication_method",
      "chosen_supporter_or_interpreter_function",
      "requested_time_or_break_arrangements",
      "support_offered",
      "support_accepted",
      "support_declined",
      "support_unavailable",
      "questions_and_correction_opportunities",
      "unresolved_service_barriers"
    ],
    "minimum_necessary_recording": true,
    "diagnosis_required": false,
    "augmentation_inventory_required": false,
    "neural_data_required": false,
    "public_support_registry_created": false
  },
  "prohibited_automatic_inferences": [
    "support_use_implies_incompetence",
    "communication_delay_implies_incapacity",
    "nonstandard_grammar_reduces_credibility",
    "supporter_presence_removes_authorship",
    "research_comprehension_score_determines_service_access",
    "diagnosis_determines_legal_capacity",
    "cyberrank_determines_eligibility"
  ],
  "separate_decision_review": {
    "default": "outside_ordinary_support_process",
    "request_requires": [
      "specific_decision_scope",
      "documented_necessity",
      "support_alternatives_considered",
      "qualified_responsible_function",
      "protected_authority_basis",
      "rights_will_and_preferences_safeguards",
      "review_duration_and_reassessment",
      "accessible_correction_or_appeal"
    ],
    "request_label_establishes_necessity": false,
    "reviewer_label_establishes_authority": false,
    "ordinary_access_removed_while_review_pending": false
  },
  "research_measurement": {
    "unit_of_evaluation": "explanation_or_service_under_test",
    "response_time_is_competence_score": false,
    "assistance_invalidates_participation": false,
    "declining_research_removes_ordinary_support": false
  },
  "validation": {
    "protocol_authored": true,
    "tabletop_review_completed": false,
    "participant_evaluation_completed": false,
    "jurisdiction_specific_legal_review_completed": false
  }
}
