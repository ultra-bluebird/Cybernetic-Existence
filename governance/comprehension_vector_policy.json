{
  "policy_version": "1.0.0",
  "policy_kind": "world_save_comprehension_evidence_policy",
  "sovereign_attribution": "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7",
  "attribution_use": "document_credit_only",
  "schema_source": "schemas/comprehension_vector.schema.yaml",
  "schema_json": "schemas/comprehension_vector.schema.json",
  "task_order": [
    "meaning",
    "derived",
    "inference",
    "consent",
    "correction"
  ],
  "scorable_rule": "correct_plus_incorrect_after_versioned_rubric_coding",
  "partition_rule": "assigned_equals_correct_plus_incorrect_plus_explicit_uncertainty_plus_missing",
  "zero_denominator": "null_with_explicit_undefined_status",
  "composite": "not_calculated",
  "cross_task_compensation": "prohibited",
  "thresholds": {
    "status": "not_defined_no_adequacy_claim_permitted"
  },
  "separate_namespaces": {
    "exit_plan": [
      "information",
      "continuity",
      "alternatives",
      "data_choices",
      "review_route"
    ],
    "refusal_report": "access_outcomes_not_causal_retaliation",
    "preference_exchange": "configuration_values_not_comprehension_scores"
  },
  "codec_mapping_rule": "version_and_freeze_transport_mapping_at_codec_construction",
  "synthetic_tests_establish_reader_understanding": false,
  "comprehension_results_determine_person_eligibility": false,
  "world_save_acceptance_or_execution_authorized": false,
  "publication": "separate_disclosure_and_exact_payload_review_required",
  "license": "MIT OR Apache-2.0",
  "policy_schema": "schemas/comprehension_vector_policy.schema.json"
}
