    "id": "@id",
    "type": "@type",
    "clauseId": "hr:clauseId",
    "appliesTo": "hr:appliesTo",
    "removalProhibited": "hr:removalProhibited",
    "amendmentProcedure": "hr:amendmentProcedure",
    "adoptedAt": {
      "@id": "hr:adoptedAt",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
