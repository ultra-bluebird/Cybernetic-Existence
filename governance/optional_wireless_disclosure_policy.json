{
  "schema_version": "1.0.0",
  "title": "Optional Wireless Disclosure Review Policy",
  "license": "MIT OR Apache-2.0",
  "status": "proposed_specification",
  "provenance": {
    "sovereign_attribution": "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7",
    "attribution_use": "document_credit_only"
  },
  "scope": {
    "subject": "optional application-level access to a disclosure",
    "global_radio_control": "not_authorized",
    "assistive_system_control": "not_authorized",
    "device_inventory": "not_authorized"
  },
  "default_configuration": {
    "optional_wireless_feature_enabled": false,
    "background_discovery": false,
    "automatic_reconnection": false,
    "ordinary_access_requires_wireless": false
  },
  "review_requirements": [
    "explicit_user_initiation",
    "working_nonwireless_alternative",
    "no_ambient_device_enumeration_for_ordinary_disclosure",
    "no_unreviewed_location_access",
    "no_persistent_cross_space_linkage",
    "no_sensitive_radio_metadata_in_diagnostics",
    "no_broader_scanning_after_failure",
    "no_interference_with_unrelated_assistive_connections"
  ],
  "testing": {
    "default_environment": "mock_transport_only",
    "real_radio_api_binding": "absent",
    "discovery_call_forwarding": "prohibited",
    "nearby_device_probing": "prohibited",
    "permission_inspection_on_personal_devices": "not_required",
    "static_and_configuration_review": "required",
    "unsupported_behavior_result": "unresolved_or_feature_disabled"
  },
  "release": {
    "feature_enablement_requires_reviewed_evidence": true,
    "user_gesture_alone_establishes_privacy": false,
    "declared_optional_label_establishes_compliance": false,
    "failed_wireless_review_removes_ordinary_access": false,
    "external_action_requires_separate_approval": true
  },
  "validation": {
    "policy_authored": true,
    "live_radio_test_performed": false,
    "nearby_devices_examined": false,
    "runtime_behavior_verified": false
  }
}
