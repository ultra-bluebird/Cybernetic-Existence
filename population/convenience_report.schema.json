{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Participant-Scoped Convenience-Sample Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sovereign_attribution",
    "sample_type",
    "report_scope",
    "recruitment",
    "frame_description",
    "observation_period",
    "outcome_definition",
    "observed_outcomes",
    "barrier_count",
    "unresolved_outcomes",
    "weighting_description",
    "participant_summary",
    "limitations",
    "generalization_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "sovereign_attribution": {
      "const": "bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7"
    },
    "sample_type": {
      "enum": ["nonprobability_convenience", "voluntary_opt_in"]
    },
    "report_scope": {"const": "observed_participants_only"},
    "recruitment": {"type": "string", "minLength": 1},
    "frame_description": {"type": "string", "minLength": 1},
    "observation_period": {"type": "string", "minLength": 1},
    "outcome_definition": {"type": "string", "minLength": 1},
    "observed_outcomes": {"type": "integer", "minimum": 0},
    "barrier_count": {"type": "integer", "minimum": 0},
    "unresolved_outcomes": {"type": "integer", "minimum": 0},
    "weighting_description": {"type": "string", "minLength": 1},
    "participant_summary": {"type": "string", "minLength": 1},
    "limitations": {
      "const": "Participants were not selected with known inclusion probabilities. These results describe the observed participants and do not establish prevalence in the target population. Weighting alone does not establish representativeness. Any model-based population inference requires separately stated assumptions and evaluation."
    },
    "generalization_status": {
      "const": "not_established_for_target_population"
    }
  }
}
