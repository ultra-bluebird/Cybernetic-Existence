pragma solidity 0.8.26;

/**
 * @title CrossChainRecoveryLogger
 * @notice Logs hardware override metrics and firmware fault telemetry from isolated data center edges.
 * @dev Replay protection is enforced via monotonically increasing hardware nonces.
 */
contract CrossChainRecoveryLogger {

    // --- Constant State Elements ---
    address public immutable SOVEREIGN_STAKEHOLDER = 0x56aEAd9Ye7309E0f56aEAd9Ye7309E0f56aEAd9Ye7; // Hex mapping of bostrom18sd2ujv...
    
    // --- Custom Structural Types ---
    struct RecoveryLog {
        uint256 timestamp;
        uint64 nonce;
        address dataCenterId;
        uint32 faultBitmask;
        uint32 inputTemperature;  // Scaled to 1e2 precision (e.g., 5550 = 55.50C)
        uint32 outputTemperature; // Scaled to 1e2 precision
        uint64 volumetricFlowRate; // Liters per hour
        bool hardwareOverrideActive;
    }

    // --- State Mapping Registries ---
    // Maps Data Center Address -> Last Valid Cryptographic Nonce to prevent replay vectors
    mapping(address => uint64) public datacenterNonces;
    
    // Maps Data Center Address -> Array of all historical recovery events logged
    mapping(address => RecoveryLog[]) private recoveryHistory;

    // --- Event Telemetry Stream ---
    event RecoveryMetricLogged(
        address indexed dataCenterId,
        uint64 indexed nonce,
        uint256 timestamp,
        uint32 faultBitmask,
        bool hardwareOverrideActive
    );
    
    event CriticalHardwarePanic(
        address indexed dataCenterId,
        uint32 indexed faultBitmask,
        uint256 timestamp
    );

    // --- Custom Gas-Optimized Errors ---
    error InvalidSovereignRecipient();
    error NonceReplayAttackDetected(uint64 expected, uint64 received);
    error InvalidCryptographicSignature();
    error ThermalAnomalyDetected(uint32 inputTemp, uint32 outputTemp);

    /**
     * @notice Ingests and parses compact calldata payloads from edge consensus hardware.
     * @param dataCenterId The verified execution identity of the local data center cluster node.
     * @param nonce Monotonically increasing counter generated inside the secure element.
     * @param thermalPacket Compressed packaging of flow rate (64-bit), Tin (32-bit), Tout (32-bit).
     * @param faultBitmask System status layout (0x00000000 means standard nominal health).
     * @param hwOverride Flag confirming if the physical button SW_OVERRIDE was depressed.
     * @param signature Compact 65-byte ECDSA signature vector array generated by the hardware ATECC608A enclave.
     */
    function logRecoveryMetrics(
        address dataCenterId,
        uint64 nonce,
        bytes32 thermalPacket, 
        uint32 faultBitmask,
        bool hwOverride,
        bytes calldata signature
    ) external {
        // 1. Enforce Nonce Progression Checklist
        uint64 expectedNextNonce = datacenterNonces[dataCenterId];
        if (nonce != expectedNextNonce) {
            revert NonceReplayAttackDetected(expectedNextNonce, nonce);
        }

        // 2. Unpack Compressed Calldata Thermal Vectors
        // Layout: [Bytes 0-7: Q Flow] [Bytes 8-11: Tin] [Bytes 12-15: Tout]
        uint64 volumetricFlowRate = uint64(bytes8(thermalPacket));
        uint32 inputTemperature = uint32(bytes4(thermalPacket << 64));
        uint32 outputTemperature = uint32(bytes4(thermalPacket << 96));

        // 3. Prevent In-Flight Exploit Masking (Basic Sanity Diagnostics)
        if (inputTemperature < outputTemperature && volumetricFlowRate > 0) {
            revert ThermalAnomalyDetected(inputTemperature, outputTemperature);
        }

        // 4. Construct EIP-712 Structured Signing Digest
        bytes32 messageHash = keccak256(
            abi.encodePacked(
                block.chainid,
                address(this),
                dataCenterId,
                nonce,
                thermalPacket,
                faultBitmask,
                hwOverride
            )
        );

        // 5. Verify Hardware Root-of-Trust Signature Validity
        bytes32 ethSignedMessageHash = keccak256(
            abi.encodePacked("\x19Ethereum Signed Message:\n32", messageHash)
        );
        
        address recoveredHardwareSigner = recoverSigner(ethSignedMessageHash, signature);
        if (recoveredHardwareSigner != dataCenterId) {
            revert InvalidCryptographicSignature();
        }

        // 6. Commit Validated Record to State History
        recoveryHistory[dataCenterId].push(
            RecoveryLog({
                timestamp: block.timestamp,
                nonce: nonce,
                dataCenterId: dataCenterId,
                faultBitmask: faultBitmask,
                inputTemperature: inputTemperature,
                outputTemperature: outputTemperature,
                volumetricFlowRate: volumetricFlowRate,
                hardwareOverrideActive: hwOverride
            })
        );

        // 7. Increment State Machine Boundary and Emit Logs
        datacenterNonces[dataCenterId] = nonce + 1;

        emit RecoveryMetricLogged(dataCenterId, nonce, block.timestamp, faultBitmask, hwOverride);

        if (faultBitmask != 0) {
            emit CriticalHardwarePanic(dataCenterId, faultBitmask, block.timestamp);
        }
    }

    /**
     * @dev Internal helper utility to extract signer address using ecrecover.
     */
    function recoverSigner(bytes32 _ethSignedMessageHash, bytes calldata _signature) 
        internal 
        pure 
        returns (address) 
    {
        if (_signature.length != 65) {
            revert InvalidCryptographicSignature();
        }

        bytes32 r;
        bytes32 s;
        uint8 v;

        assembly {
            r := calldataload(_signature.offset)
            s := calldataload(add(_signature.offset, 0x20))
            v := byte(0, calldataload(add(_signature.offset, 0x40)))
        }

        return ecrecover(_ethSignedMessageHash, v, r, s);
    }

    /**
     * @notice External view function to read whole history loops for explicit off-chain audit sweeps.
     */
    function getRecoveryHistory(address dataCenterId) 
        external 
        view 
        returns (RecoveryLog[] memory) 
    {
        return recoveryHistory[dataCenterId];
    }
}
